    "---\n",
    "## Cell 7: Incident Management Functions\n",
    "\n",
    "Helper functions to save new incidents and complete analysis results.\n",
    "These are called automatically after each pipeline run so the system\n",
    "continuously grows its knowledge base."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def save_incident(change: str, incident: str, severity: str, impact: str) -> None:\n",
    "    \"\"\"\n",
    "    Append a new incident to the persistent incident database.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    change : str\n",
    "        Description of the infrastructure change that triggered the incident.\n",
    "    incident : str\n",
    "        What actually went wrong.\n",
    "    severity : str\n",
    "        Severity level (low / medium / high / critical).\n",
    "    impact : str\n",
    "        Business impact description.\n",
    "    \"\"\"\n",
    "    with open(INCIDENT_FILE, \"r\") as f:\n",
    "        data = json.load(f)\n",
    "\n",
    "    data.append({\n",
    "        \"change\": change,\n",
    "        \"incident\": incident,\n",
    "        \"severity\": severity,\n",
    "        \"impact\": impact\n",
    "    })\n",
    "\n",
    "    with open(INCIDENT_FILE, \"w\") as f:\n",
    "        json.dump(data, f, indent=2)\n",
    "\n",
    "\n",
    "def save_analysis(change, plan, risk, solution, rollout, final_output) -> None:\n",
    "    \"\"\"\n",
    "    Persist the full analysis pipeline output for a given change request.\n",
    "    Every run becomes training memory for future analyses.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    change : str\n",
    "        The original change request.\n",
    "    plan : str\n",
    "        Output from the Planner Agent.\n",
    "    risk : str\n",
    "        Output from the Risk Agent.\n",
    "    solution : str\n",
    "        Output from the Solution Agent.\n",
    "    rollout : str\n",
    "        Output from the Rollout Agent.\n",
    "    final_output : str\n",
    "        The refined executive report.\n",
    "    \"\"\"\n",
    "    with open(HISTORY_FILE, \"r\") as f:\n",
    "        history = json.load(f)\n",
    "\n",
    "    history.append({\n",
    "        \"timestamp\": str(datetime.now()),\n",
    "        \"change\": change,\n",
    "        \"planner\": plan,\n",
    "        \"risk\": risk,\n",
    "        \"solution\": solution,\n",
    "        \"rollout\": rollout,\n",
    "        \"final_output\": final_output\n",
    "    })\n",
    "\n",
