    "---\n",
    "## Cell 8: FAISS Vector Store Setup\n",
    "\n",
    "Initialize the sentence-transformer embedding model and FAISS index.\n",
    "The incident database is embedded into vectors so we can retrieve\n",
    "the most semantically similar past incidents for any new change request."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "
    "# Load the embedding model (downloads on first use)\n",
    "embedder = SentenceTransformer(EMBEDDING_MODEL)\n",
    "\n",
    "# FAISS index for cosine similarity (using inner product on normalized vectors)\n",
    "dimension = 384  # all-MiniLM-L6-v2 produces 384-dim vectors\n",
    "faiss_index = faiss.IndexFlatIP(dimension)  # Inner product = cosine after normalization\n",
    "\n",
    "# Maps FAISS indices back to incident records\n",
    "incident_lookup = []\n",
    "\n",
    "\n",
    "def build_faiss_index() -> None:\n",
    "    \"\"\"\n",
    "    (Re)build the FAISS index from the current incident database.\n",
    "    Called at startup and whenever new incidents are learned.\n",
    "    \"\"\"\n",
    "    global incident_lookup\n",
    "\n",
    "    with open(INCIDENT_FILE, \"r\") as f:\n",
    "        incidents = json.load(f)\n",
    "\n",
    "    if len(incidents) == 0:\n",
    "        print(\"No incidents to index.\")\n",
    "        return\n",
    "\n",
    "    # Create searchable text from each incident record\n",
    "    texts = [\n",
    "        f\"Change: {inc['change']}. Incident: {inc['incident']}. \"\n",
    "        f\"Severity: {inc['severity']}. Impact: {inc['impact']}.\"\n",
    "        for inc in incidents\n",
    "    ]\n",
    "\n",
    "    # Encode all texts into vectors and normalize for cosine similarity\n",
    "    vectors = embedder.encode(texts, show_progress_bar=False)\n",
    "    faiss.normalize_L2(vectors)\n",
    "\n",
    "    # Reset and rebuild the index\n",
    "    faiss_index.reset()\n",
    "    faiss_index.add(vectors.astype(np.float32))\n",
    "    incident_lookup = incidents\n",
    "\n",
    "    print(f\"FAISS index built with {len(incidents)} incidents\")\n",
    "\n",
    "\n",
    "# Build the index on first load\n",
    "build_faiss_index()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Cell 9: Incident Retrieval Function\n",
    "\n",
    "Given a new change request, retrieve the top-k most similar past incidents\n",
    "from the FAISS index. This provides historical context to the Risk Agent."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def retrieve_incidents(change: str, k: int = 3) -> str:\n",
    "    \"\"\"\n",
    "    Retrieve the k most similar incidents for a given change request.\n",
    "\n",
    "    Uses FAISS inner-product search on normalized embeddings\n",
    "    to find semantically similar past incidents.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    change : str\n",
    "        The new change request text.\n",
    "    k : int\n",
    "        Number of similar incidents to retrieve.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    str : A formatted string of retrieved incidents.\n",
    "    \"\"\"\n",
    "    if faiss_index.ntotal == 0:\n",
    "        return \"No incidents in database yet.\"\n",
    "\n",
    "    # Embed the query and normalize\n",
    "    query_vec = embedder.encode([change])\n",
    "    faiss.normalize_L2(query_vec)\n",
    "\n",
    "    # Search FAISS for the top-k nearest neighbors\n",
    "    k = min(k, faiss_index.ntotal)  # Don't request more than available\n",
    "    scores, indices = faiss_index.search(query_vec.astype(np.float32), k)\n",
    "\n",
    "    # Format results\n",
    "    results = []\n",
    "    for score, idx in zip(scores[0], indices[0]):\n",
    "        if idx < len(incident_lookup):\n",
    "            inc = incident_lookup[idx]\n",
    "            results.append(\n",
    "                f\"- [{score:.3f}] Change: {inc['change']} | \"\n",
    "                f\"Incident: {inc['incident']} | \"\n",
    "                f\"Severity: {inc['severity']} | \"\n",
    "                f\"Impact: {inc['impact']}\"\n",
    "            )\n",
    "\n",
    "    return \"\\n\".join(results) if results else \"No matching incidents found.\"\n",
    "\n",
    "\n",
    "# Quick test\n",
    "print(retrieve_incidents(\"redis upgrade\"))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Cell 10: Memory Agent\n",
    "\n",
    "The Memory Agent loads previous analyses from the history file and\n",
    "identifies similar changes, previous failures, successful rollbacks,\n",
    "and useful lessons. This gives the system long-term learning capability."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def memory_agent(change: str) -> str:\n",
    "    \"\"\"\n",
    "    Analyse the history of past pipeline runs to find relevant context\n",
    "    for the current change request.\n",
    "\n",
    "    Looks at the last 10 analyses for:\n",
    "    1. Similar changes that were processed before\n",
    "    2. Previous failures or issues\n",
    "    3. Successful rollbacks and mitigations\n",
    "    4. Useful lessons learned\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    change : str\n",
    "        The new change request to analyse.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    str : Markdown-formatted memory analysis.\n",
    "    \"\"\"\n",
    "    with open(HISTORY_FILE, \"r\") as f:\n",
    "        history = json.load(f)\n",
    "\n",
    "    if len(history) == 0:\n",
    "        return \"No previous history available. This is the first analysis.\"\n",
    "\n",
    "    # Use the last 10 analyses as context window\n",
    "    context = history[-10:]\n",
    "\n",
    "    prompt = f\"\"\"\n",
    "You are the Memory Agent in an Infrastructure Change Risk Assessment system.\n",
    "\n",
    "Current Change Request:\n",
    "{change}\n",
    "\n",
    "Past Analyses (most recent first):\n",
    "{json.dumps(context, indent=2)}\n",
    "\n",
    "Based on this history, identify:\n",
    "1. Similar Changes - Have we seen something like this before?\n",
    "2. Previous Failures - What went wrong with similar changes?\n",
    "3. Successful Rollbacks - What recovery strategies worked?\n",
    "4. Useful Lessons - What should we keep in mind?\n",
    "\n",
    "Return your analysis in markdown format.\n",
    "\"\"\"\n",
    "\n",
    "    return ask_llm(prompt)\n",
    "\n",
    "\n",
    "print(\"Memory Agent ready\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Cell 11: Planner Agent\n",
    "\n",
    "The Planner Agent takes a change request and generates a detailed\n",
    "step-by-step execution plan, including prerequisites, steps, and\n",
    "verification checkpoints."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def planner_agent(change: str) -> str:\n",
    "    \"\"\"\n",
    "    Generate a step-by-step execution plan for an infrastructure change.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    change : str\n",
    "        The change request to plan.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    str : Markdown-formatted execution plan.\n",
    "    \"\"\"\n",
    "    prompt = f\"\"\"\n",
    "You are an Infrastructure Planner Agent.\n",
    "\n",
    "Change Request:\n",
    "{change}\n",
    "\n",
    "Generate a detailed execution plan covering:\n",
    "1. Prerequisites (dependencies, approvals, backups)\n",
    "2. Step-by-step execution instructions\n",
    "3. Verification checkpoints after each major step\n",
    "4. Estimated timeline\n",
    "5. Required resources and team members\n",
    "\n",
    "Return the plan in markdown format.\n",
    "\"\"\"\n",
    "    return ask_llm(prompt)\n",
    "\n",
    "\n",
    "print(\"Planner Agent ready\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Cell 12: Incident Retrieval Agent\n",
    "\n",
    "Combines FAISS-based incident retrieval with LLM analysis to identify\n",
    "common failure patterns, risk indicators, and historical impacts.\n",
    "This replaces the simple retrieval with an intelligent analysis layer."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def retrieval_agent(change: str) -> str:\n",
    "    \"\"\"\n",
    "    Retrieve similar incidents via FAISS and analyse them with the LLM.\n",
    "\n",
    "    This agent bridges the vector search results with intelligent analysis,\n",
    "    providing context-rich incident summaries for the Risk Agent.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    change : str\n",
    "        The change request to find incidents for.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    str : Markdown-formatted incident analysis.\n",
    "    \"\"\"\n",
    "    # Retrieve top 5 similar incidents from FAISS\n",
    "    incidents = retrieve_incidents(change, k=5)\n",
    "\n",
    "    prompt = f\"\"\"\n",
    "You are the Incident Retrieval Agent.\n",
    "\n",
    "Current Change Request:\n",
    "{change}\n",
    "\n",
    "Retrieved Similar Incidents:\n",
    "{incidents}\n",
    "\n",
    "Analyse these incidents and provide:\n",
    "1. Common Failure Patterns - What recurring issues appear?\n",
    "2. Risk Indicators - What warning signs should we watch for?\n",
    "3. Historical Impacts - What was the typical business impact?\n",
    "4. Recommended Pre-checks - What should we verify before proceeding?\n",
    "\n",
    "Return your analysis in markdown format.\n",
    "\"\"\"\n",
    "    return ask_llm(prompt)\n",
    "\n",
    "\n",
    "print(\"Retrieval Agent ready\")"
   ]
