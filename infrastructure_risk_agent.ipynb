    "---\n",
    "## Cell 17: Knowledge Learning Function\n",
    "\n",
    "After every pipeline run, extract incident knowledge from the output\n",
    "and add it to the incident database. This creates a self-improving\n",
    "system that continuously grows its incident knowledge base."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def learn_from_run(change: str, final_output: str) -> None:\n",
    "    \"\"\"\n",
    "    Extract incident knowledge from a completed analysis run and\n",
    "    add it to the persistent incident database.\n",
    "\n",
    "    This enables the system to learn from every analysis it performs,\n",
    "    building an increasingly comprehensive knowledge base over time.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    change : str\n",
    "        The original change request.\n",
    "    final_output : str\n",
    "        The refined executive report.\n",
    "    \"\"\"\n",
    "    prompt = f\"\"\"\n",
    "Extract incident knowledge from this infrastructure change analysis.\n",
    "\n",
    "Change Request:\n",
    "{change}\n",
    "\n",
    "Analysis Output:\n",
    "{final_output}\n",
    "\n",
    "Return a JSON array of incident objects extracted from the analysis.\n",
    "Each object should have: change, incident, severity, impact.\n",
    "If no incidents are identified, return an empty array: []\n",
    "\n",
    "Return ONLY valid JSON, no other text.\n",
    "\"\"\"\n",
    "\n",
    "    result = ask_llm(prompt)\n",
    "\n",
    "    try:\n",
    "        # Parse the LLM's JSON response\n",
    "        # Strip markdown code fences if present\n",
    "        cleaned = result.strip()\n",
    "        if cleaned.startswith(\"```\"):\n",
    "            cleaned = cleaned.split(\"\\n\", 1)[1]  # Remove opening fence\n",
    "        if cleaned.endswith(\"```\"):\n",
    "            cleaned = cleaned.rsplit(\"```\", 1)[0]  # Remove closing fence\n",
    "        cleaned = cleaned.strip()\n",
    "\n",
    "        new_incidents = json.loads(cleaned)\n",
    "\n",
    "        if isinstance(new_incidents, list) and len(new_incidents) > 0:\n",
    "            # Merge with existing incidents\n",
    "            with open(INCIDENT_FILE, \"r\") as f:\n",
    "                existing = json.load(f)\n",
    "\n",
    "            existing.extend(new_incidents)\n",
    "\n",
    "            with open(INCIDENT_FILE, \"w\") as f:\n",
    "                json.dump(existing, f, indent=2)\n",
    "\n",
    "            # Rebuild FAISS index with new data\n",
    "            build_faiss_index()\n",
    "\n",
    "            print(f\"Learned {len(new_incidents)} new incident(s) from this run\")\n",
    "        else:\n",
    "            print(\"No new incidents to learn from this run\")\n",
    "\n",
    "    except (json.JSONDecodeError, KeyError, TypeError) as e:\n",
    "        print(f\"Could not parse incident data from LLM response: {e}\")\n",
    "\n",
    "\n",
    "print(\"Learning function ready\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Cell 18: Full Pipeline\n",
    "\n",
    "The complete multi-agent pipeline that chains all agents together.\n",
    "This is the main execution flow:\n",
    "\n",
    "1. **Memory** - Load historical context\n",
    "2. **Plan** - Generate execution plan\n",
    "3. **Retrieve** - Find similar incidents via FAISS\n",
    "4. **Risk** - Assess risk level\n",
    "5. **Solution** - Generate mitigations\n",
    "6. **Rollout** - Design deployment strategy\n",
    "7. **Refine** - Combine into executive report\n",
    "8. **Save** - Persist results and learn"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def run_pipeline(change: str) -> str:\n",
    "    \"\"\"\n",
    "    Execute the full multi-agent pipeline for an infrastructure change.\n",
    "\n",
    "    Chains: Memory -> Planner -> Retrieval -> Risk -> Solution -> Rollout -> Refiner\n",
    "    Then persists the results and learns from the run.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    change : str\n",
    "        The infrastructure change request to analyse.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    str : The final executive report.\n",
    "    \"\"\"\n",
    "    print(\"=\" * 60)\n",
    "    print(\"Starting Infrastructure Change Risk Assessment\")\n",
    "    print(\"=\" * 60)\n",
    "\n",
    "    # Step 1: Memory Agent - Load historical context\n",
    "    print(\"\\n[1/7] Running Memory Agent...\")\n",
    "    memory = memory_agent(change)\n",
    "    print(\"  -> Memory analysis complete\")\n",
    "\n",
    "    # Step 2: Planner Agent - Generate execution plan\n",
    "    print(\"\\n[2/7] Running Planner Agent...\")\n",
    "    plan = planner_agent(change)\n",
    "    print(\"  -> Execution plan generated\")\n",
    "\n",
    "    # Step 3: Retrieval Agent - Find similar incidents via FAISS\n",
    "    print(\"\\n[3/7] Running Retrieval Agent...\")\n",
    "    retrieved = retrieval_agent(change)\n",
    "    print(\"  -> Incident analysis complete\")\n",
    "\n",
    "    # Step 4: Risk Agent - Assess risk with full context\n",
    "    print(\"\\n[4/7] Running Risk Agent...\")\n",
    "    risk = risk_agent(change + \"\\n\\n\" + retrieved)\n",
    "    print(\"  -> Risk assessment complete\")\n",
    "\n",
    "    # Step 5: Solution Agent - Generate mitigation solutions\n",
    "    print(\"\\n[5/7] Running Solution Agent...\")\n",
    "    solution = solution_agent(change, risk)\n",
    "    print(\"  -> Solutions generated\")\n",
    "\n",
    "    # Step 6: Rollout Agent - Design deployment strategy\n",
    "    print(\"\\n[6/7] Running Rollout Agent...\")\n",
    "    rollout = rollout_agent(change, risk)\n",
    "    print(\"  -> Rollout strategy designed\")\n",
    "\n",
    "    # Step 7: Refiner Agent - Combine into executive report\n",
    "    print(\"\\n[7/7] Running Refiner Agent...\")\n",
    "    final_report = refiner_agent(change, memory, plan, risk, solution, rollout)\n",
    "    print(\"  -> Executive report generated\")\n",
    "\n",
    "    # Persist results\n",
    "    print(\"\\nSaving analysis to history...\")\n",
    "    save_analysis(change, plan, risk, solution, rollout, final_report)\n",
    "\n",
    "    # Learn from this run\n",
    "    print(\"Learning from this run...\")\n",
    "    learn_from_run(change, final_report)\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 60)\n",
    "    print(\"Pipeline Complete\")\n",
    "    print(\"=\" * 60)\n",
    "\n",
    "    return final_report\n",
    "\n",
    "\n",
    "print(\"Pipeline ready\")"
   ]
  },
